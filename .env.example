# Optional configuration. Every value below is a default already baked into
# app/config.py - copy to .env only to override.

# --- Bot-defence pacing (the important ones) -------------------------------
# market.sec.or.th is fronted by an F5/Shape defence that starts serving a
# JavaScript interstitial when requests arrive too fast. These two knobs are the
# primary guard. Both are enforced PER PROCESS, so run a single worker and a
# single replica or the effective request rate multiplies and trips the block.
SEC_MIN_REQUEST_INTERVAL=1.0
SEC_MAX_CONCURRENT_REQUESTS=2
SEC_CHALLENGE_BACKOFF_BASE=5.0

# --- HTTP ------------------------------------------------------------------
SEC_HTTP_TIMEOUT=60
SEC_HTTP_MAX_RETRIES=3
SEC_HTTP_BACKOFF_BASE=0.8
SEC_HTTP_MAX_CONNECTIONS=4

# --- Cache TTL, in seconds -------------------------------------------------
# Caches are in-process and reset on redeploy.
SEC_CACHE_TTL_SYMBOLS=86400
SEC_CACHE_TTL_PROFILE=21600
SEC_CACHE_TTL_FORM59=1800

# --- Bulk endpoints --------------------------------------------------------
SEC_BULK_MAX_SYMBOLS=50
SEC_BULK_CONCURRENCY=2

# --- Upstream --------------------------------------------------------------
SEC_BASE_URL=https://market.sec.or.th

# --- MCP server ------------------------------------------------------------
# REQUIRED to enable the MCP endpoint at /mcp. Minimum 24 characters; without it
# the endpoint is not mounted at all (fail closed). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(40))"
MCP_AUTH_TOKEN=

# Also require the token on the REST API. /health and / stay open so platform
# healthchecks keep working. Default off, so enabling MCP does not break
# existing REST consumers.
REST_AUTH_REQUIRED=false

# Extra Host / Origin values for MCP's DNS-rebinding protection, comma
# separated. Railway's RAILWAY_PUBLIC_DOMAIN is added automatically; set these
# only for a custom domain. "*" in MCP_ALLOWED_HOSTS disables the check.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
